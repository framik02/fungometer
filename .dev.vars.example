# Copy to .dev.vars for LOCAL use only. Never commit secrets.
APP_ENV="local"
APP_ORIGIN="http://127.0.0.1:8787"
AUTH_ENABLED="true"
PAYMENTS_MODE="test"
AUTH_SECRET="replace-with-32-random-bytes-or-more"
# Local login codes are displayed ONLY on a loopback origin in APP_ENV=local.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# RESEND_API_KEY="re_..."
# MAIL_FROM="FungoMeter <accesso@your-domain.it>"
# TURNSTILE_SECRET_KEY="..."
