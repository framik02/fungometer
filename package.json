{
  "name": "fungometer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "test": "node --test tests-web/*.test.mjs",
    "build": "node scripts/build-cloudflare.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "deploy": "npm run test && npm run check:deploy && npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply fungometer --local"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
